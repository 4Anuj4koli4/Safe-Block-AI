# ===================================================
# SafeBlock AI - Example Environment Configuration
# Copy this file to '.env' and adjust values as needed.
# ===================================================

# --- Database Configuration ---
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=crime_db
MYSQL_HOST=localhost
MYSQL_PORT=3307

# Database Connection URL (SQLAlchemy format)
# For local host execution: mysql+pymysql://root:<PASSWORD>@localhost:3307/crime_db
# For Docker Compose: mysql+pymysql://root:<PASSWORD>@db:3306/crime_db
DATABASE_URL=mysql+pymysql://root:your_root_password_here@localhost:3307/crime_db

# --- Backend API Configuration ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend Configuration ---
VITE_API_URL=http://localhost:8000
WEB_PORT=3000
